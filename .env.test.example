# Disposable automated test environment. It must contain synthetic data only.
COMPOSE_PROJECT_NAME=mediqueue-test
APP_VERSION=test

POSTGRES_DB=mediqueue_test
POSTGRES_USER=mediqueue_test_bootstrap
POSTGRES_PASSWORD=test-only-database-password
MEDIQUEUE_MIGRATION_USER=mediqueue_test_owner
MEDIQUEUE_MIGRATION_PASSWORD=test-only-owner-database-password
MEDIQUEUE_APP_USER=mediqueue_test_runtime
MEDIQUEUE_APP_PASSWORD=test-only-runtime-database-password
DATABASE_URL=postgresql://mediqueue_test_runtime:test-only-runtime-database-password@db:5432/mediqueue_test
MIGRATION_DATABASE_URL=postgresql://mediqueue_test_owner:test-only-owner-database-password@db:5432/mediqueue_test

DJANGO_SECRET_KEY=test-only-django-secret-key-that-is-longer-than-fifty-characters-2026
MFA_ENCRYPTION_KEY=test-only-separate-mfa-encryption-key-2026
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8081
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
ALLOW_INSECURE_TEST_SETTINGS=true
DJANGO_BEHIND_PROXY=true
HOSPITAL_TIME_ZONE=Asia/Dhaka
PUBLIC_BASE_URL=http://localhost:8081
LOG_LEVEL=WARNING

DEFAULT_FROM_EMAIL=MediQueue Test <no-reply@example.test>
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
OUTBOX_POLL_SECONDS=1
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=2
GROQ_REASONING_EFFORT=low

WEB_PORT=8081
PUBLIC_HOSTNAME=:80
