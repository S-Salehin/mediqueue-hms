# Template only. Staging is HTTPS and synthetic-data-only.
DEPLOY_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=mediqueue-staging
RELEASE_ID=CHANGE_ME_RELEASE_TAG
APP_VERSION=CHANGE_ME_GIT_COMMIT

APP_IMAGE=ghcr.io/s-salehin/mediqueue-api@sha256:CHANGE_ME
WEB_IMAGE=ghcr.io/s-salehin/mediqueue-web@sha256:CHANGE_ME
DATABASE_IMAGE=ghcr.io/s-salehin/mediqueue-db@sha256:CHANGE_ME

POSTGRES_DB=mediqueue_staging
POSTGRES_USER=mediqueue_staging_bootstrap
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_BOOTSTRAP_PASSWORD
MEDIQUEUE_MIGRATION_USER=mediqueue_staging_owner
MEDIQUEUE_MIGRATION_PASSWORD=CHANGE_ME_SEPARATE_RANDOM_OWNER_PASSWORD
MEDIQUEUE_APP_USER=mediqueue_staging_runtime
MEDIQUEUE_APP_PASSWORD=CHANGE_ME_SEPARATE_RANDOM_RUNTIME_PASSWORD
DATABASE_URL=postgresql://mediqueue_staging_runtime:CHANGE_ME_URL_ENCODED_RUNTIME_PASSWORD@db:5432/mediqueue_staging
MIGRATION_DATABASE_URL=postgresql://mediqueue_staging_owner:CHANGE_ME_URL_ENCODED_OWNER_PASSWORD@db:5432/mediqueue_staging

DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_DJANGO_SECRET
MFA_ENCRYPTION_KEY=CHANGE_ME_SEPARATE_RANDOM_MFA_ENCRYPTION_KEY
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=CHANGE_ME_STAGING_HOSTNAME
DJANGO_CSRF_TRUSTED_ORIGINS=https://CHANGE_ME_STAGING_HOSTNAME
DJANGO_SECURE_COOKIES=true
DJANGO_BEHIND_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
HOSPITAL_TIME_ZONE=Asia/Dhaka
PUBLIC_BASE_URL=https://CHANGE_ME_STAGING_HOSTNAME
LOG_LEVEL=INFO

DEFAULT_FROM_EMAIL=MediQueue Staging <CHANGE_ME_STAGING_SENDER>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=CHANGE_ME_STAGING_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_STAGING_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_STAGING_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
OUTBOX_POLL_SECONDS=5
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

PUBLIC_HOSTNAME=CHANGE_ME_STAGING_HOSTNAME
ACME_EMAIL=CHANGE_ME_CERTIFICATE_CONTACT
HTTP_PORT=80
HTTPS_PORT=443

BACKUP_REPOSITORY_PATH=/srv/mediqueue-staging-backup
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_LONG_RANDOM_BACKUP_PASSPHRASE
BACKUP_RETENTION_DAYS=30

REAL_DATA_APPROVED=false
OFF_HOST_BACKUP_APPROVED=false
GHCR_USERNAME=CHANGE_ME_GITHUB_USER
GHCR_TOKEN=CHANGE_ME_FINE_GRAINED_READ_TOKEN
