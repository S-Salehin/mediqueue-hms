{
	admin off
	auto_https off
}

:8090 {
	log off
	respond /healthz 200
	respond 404
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	route {
		@api path /api /api/*
		header @api Cache-Control "no-store"

		@backend path /api /api/* /static /static/*
		reverse_proxy @backend api:8000
		reverse_proxy frontend:5173
	}
}
