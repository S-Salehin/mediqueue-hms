# Local development only. Copy this file to .env and replace every change-this value.
COMPOSE_PROJECT_NAME=mediqueue-dev
APP_VERSION=local

POSTGRES_DB=mediqueue
POSTGRES_USER=mediqueue_bootstrap
POSTGRES_PASSWORD=change-this-local-password
MEDIQUEUE_MIGRATION_USER=mediqueue_owner
MEDIQUEUE_MIGRATION_PASSWORD=change-this-local-owner-password
MEDIQUEUE_APP_USER=mediqueue_runtime
MEDIQUEUE_APP_PASSWORD=change-this-local-runtime-password
DATABASE_URL=postgresql://mediqueue_runtime:change-this-local-runtime-password@db:5432/mediqueue
MIGRATION_DATABASE_URL=postgresql://mediqueue_owner:change-this-local-owner-password@db:5432/mediqueue

DJANGO_SECRET_KEY=change-this-local-secret-key-before-starting
# Local DEBUG mode can fall back to DJANGO_SECRET_KEY. Set a separate value when testing MFA lifecycle behaviour.
MFA_ENCRYPTION_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_SECURE_COOKIES=false
DJANGO_BEHIND_PROXY=true
HOSPITAL_TIME_ZONE=Asia/Dhaka
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

DEFAULT_FROM_EMAIL=MediQueue Development <no-reply@localhost>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
OUTBOX_POLL_SECONDS=2
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

WEB_PORT=8080
MAILPIT_PORT=8025
PUBLIC_HOSTNAME=:80
